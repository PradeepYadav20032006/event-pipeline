# RabbitMQ Connection Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=pipeline_user
RABBITMQ_PASSWORD=pipeline_pass
RABBITMQ_VHOST=/
RABBITMQ_URL=amqp://pipeline_user:pipeline_pass@localhost:5672/

# Application Settings
APP_NAME=Resilient Event Pipeline
APP_ENV=development
DEBUG=True

# Queue & Retry Ring Settings
MAX_RETRIES=3
RETRY_BASE_TTL_MS=5000
